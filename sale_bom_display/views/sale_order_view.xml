<odoo>
    <record id="view_order_form_inherit_bom" model="ir.ui.view">
        <field name="name">sale.order.form.bom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Tree view mein BOM column add karo -->
            <!-- <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="after">
                <field name="bom_components_text" string="BoM Components" optional="show"/>
            </xpath> -->
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="bom_components_text" string="BoM Components"/>
            </xpath>
            <!-- Form popup mein detailed table bhi raho -->
            <xpath expr="//field[@name='order_line']/form//field[@name='name']" position="after">
                <group string="BoM Components" col="1">
                    <field name="bom_component_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="product_id" string="Component"/>
                            <field name="product_qty" string="Qty"/>
                            <field name="product_uom_id" string="Unit"/>
                        </tree>
                    </field>
                </group>
            </xpath>

        </field>
    </record>
</odoo>