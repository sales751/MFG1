<odoo>
    <record id="view_order_line_inherit_bom" model="ir.ui.view">
        <field name="name">sale.order.line.bom</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="bom_components_text" string="BoM Summary"/>
            </xpath>
        </field>
    </record>
</odoo>