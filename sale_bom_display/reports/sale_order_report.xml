<odoo>
    <template id="report_saleorder_inherit_bom" inherit_id="sale.report_saleorder_document">

        <!-- Add column header -->
        <xpath expr="//table//thead//tr//th[last()]" position="after">
            <th>BoM</th>
        </xpath>

        <!-- Add column value -->
        <xpath expr="//table//tbody//tr//td[last()]" position="after">
            <td>
                <t t-if="line.bom_ids">
                    <t t-foreach="line.bom_ids" t-as="bom">
                        <span t-esc="bom.display_name"/><br/>
                    </t>
                </t>
            </td>
        </xpath>

    </template>
</odoo>