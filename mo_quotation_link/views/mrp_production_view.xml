<odoo>
  <record id="view_mrp_production_form_quotation_link" model="ir.ui.view">
    <field name="name">mrp.production.form.quotation.link</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//page[@name='miscellaneous']//field[@name='origin']" position="after">

        <field name="sale_order_id"
               string="Linked Quotation"
               options="{'no_create': True}"/>

        <field name="sale_order_partner"
               string="Customer"
               readonly="1"/>

        <field name="sale_order_amount"
               string="Quotation Amount"
               readonly="1"/>

        <field name="sale_order_state"
               string="Quotation Status"
               readonly="1"
               widget="badge"
               decoration-success="sale_order_state == 'sale'"
               decoration-warning="sale_order_state == 'sent'"
               decoration-info="sale_order_state == 'draft'"/>

      </xpath>

    </field>
  </record>
</odoo>